  "constraints": {
    "allowed_fdi": [
      "11-18",
      "21-28",
      "31-38",
      "41-48",
      "51-55",
      "61-65",
      "71-75",
      "81-85"
    ],
    "coordinate": "[x, y] normalized to 0-1",
    "cephalometric_key": "structure_code",
    "periapical_key": "structure_code (one target FDI per case, supplied in the prompt)",
    "duplicates": "Duplicate structure keys are normalized to one entry, preserving first occurrence."
  }
}
