      "Pog`",
      "Sn"
    ],
    "periapical_structures": {
      "MESIAL_CEJ": "近中釉牙骨质界",
      "DISTAL_CEJ": "远中釉牙骨质界",
      "ROOT_APEX": "根尖",
      "MESIAL_ALVEOLAR_CREST": "近中牙槽嵴顶",
      "DISTAL_ALVEOLAR_CREST": "远中牙槽嵴顶",
      "FURCATION": "根分叉"
    }
