{
  "task_code": "A3.2",
  "name": "软组织异常定位",
  "input": {"images": 1, "fields": ["evaluation_scope"]},
  "modes": {
    "region": {
      "output_format": {"type": "json", "fields": ["findings"], "finding_shape": "finding_code_and_region_code"},
      "scoring": {"case_points": 100.0, "fields": [{"key": "findings", "weight": 1.0, "metric": "correct_pairs_over_union"}]}
    },
    "bbox": {
      "output_format": {"type": "json", "fields": ["findings"], "finding_shape": "finding_code_and_bbox"},
      "scoring": {"case_points": 100.0, "fields": [{"key": "findings", "weight": 1.0, "metric": "correct_pairs_over_union"}], "bbox_iou_threshold": 0.5}
    }
  },
  "scoring": {
    "case_points": 100.0,
    "fields": [{"key": "findings", "weight": 1.0, "metric": "correct_pairs_over_union"}],
    "bbox_iou_threshold": 0.5
  },
  "constraints": {
    "finding_codes": ["白色改变", "红色改变", "红白混合改变", "色素性改变", "溃疡", "糜烂", "水疱 / 大疱", "斑块样隆起", "丘疹 / 结节", "肿物", "萎缩"],
    "region_codes": ["舌背", "舌腹", "舌缘", "左颊黏膜", "右颊黏膜", "上唇", "下唇", "腭部", "上牙弓", "下牙弓"],
    "bbox": "[left, top, right, bottom] normalized to 0-1"
  }
}
